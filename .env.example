# Copy to `.env` (git-ignored) and set OPENAI_API_KEY. The stack does not start without it;
# every other value is optional.

# The key for the models. Required.
OPENAI_API_KEY=
# For EU data residency use an EU project key with https://eu.api.openai.com/v1
OPENAI_BASE_URL=

ASPIDA_MODEL_INLINE=gpt-6-luna
ASPIDA_MODEL_OFFLINE=gpt-5-mini
ASPIDA_MODEL_EMBEDDING=text-embedding-3-large

# `true` loads a fictional organisation on first start: past activity, client names,
# documents and discovered tools. `false` starts empty.
SEED_DEMO_DATA=false

# Host ports.
WEB_PORT=8080
GATEWAY_PORT=8000

# Database password for the internal Postgres (never exposed on the host).
POSTGRES_PASSWORD=aspida
